# Configuración de SonarQube (se usa con docker-compose.sonar.yml)
# NO subas este archivo a Git con un token real dentro.

# Puerto de tu PC para abrir SonarQube en el navegador
PORT_SONARQUBE=9000

# Clave de la base de datos interna de SonarQube (uso local)
SONAR_DB_PASSWORD=sonar

# Token de análisis: se genera en SonarQube (ver README, sección SonarQube)
# y se pega aquí, sin espacios ni comillas. Ejemplo: SONAR_TOKEN=squ_abc123...
SONAR_TOKEN=squ_93d7b7f6b6c8c035b3689e4b325d6aded3e34853
